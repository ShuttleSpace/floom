<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml for the Floem Android example (built via `cargo ndk` +
  scripts/build-apk.sh — no Gradle/AGP).

  This example goes beyond the bare `native-activity` setup: it wires the
  optional `FloemNativeActivity` Java subclass (see the inline note on the
  <activity> and `FloemNativeActivity.java`) so the app can receive runtime
  file shares (ACTION_SEND / SEND_MULTIPLE / ACTION_VIEW via onNewIntent) and
  Storage Access Framework file-dialog results (onActivityResult). Because there
  is now Java code, `android:hasCode="false"` is NOT set and `build-apk.sh`
  compiles the class to a `classes.dex`.

  The three intent-filters below make the app a share target and "open with"
  target. Scope the `<data android:mimeType="...">` to the file types your app
  actually handles instead of "*/*" to avoid hijacking every share on the device.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.floem"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- OpenGL ES 3.0+ is required by the GPU renderer surface. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="Floem Example">

        <!--
          This Floem example uses the optional `FloemNativeActivity` Java
          subclass directly so it can receive runtime file shares (ACTION_SEND /
          ACTION_VIEW via onNewIntent) and file-dialog results (onActivityResult).
          `build-apk.sh` compiles that class to a `classes.dex` and bundles it;
          `android:hasCode="false"` must therefore NOT be set here.

          For your own app: copy `FloemNativeActivity.java`, set
          `android:name="dev.floem.android.FloemNativeActivity"`, drop
          `android:hasCode="false"`, and rebuild with `cargo ndk` + a Java-capable
          APK script. If you instead keep the default `android.app.NativeActivity`
          (hasCode="false"), cold-start shares still work via `getIntent()`, but
          runtime shares / file-dialog results are dropped.
        -->
        <activity
            android:name="dev.floem.android.FloemNativeActivity"
            android:label="Floem Example"
            android:configChanges="orientation|screenSize|keyboardHidden|density"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <meta-data
                android:name="android.app.lib_name"
                android:value="floem_android_example" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Make the app a share target (ACTION_SEND / SEND_MULTIPLE). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Make the app openable from a file manager / browser (ACTION_VIEW). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
