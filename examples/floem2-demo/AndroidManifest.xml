<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal AndroidManifest.xml for the Floem 2.0 demo app, built via `cargo ndk`.

  The `android.app.lib_name` meta-data MUST match the `[lib] name` in
  `Cargo.toml` (`floem2_demo`): that is the `*.so` `native-activity` loads.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.floem2demo"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- OpenGL ES 3.0+ is required by the GPU renderer surface. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="Floem 2.0 Demo"
        android:hasCode="false"
        android:exported="true">

        <activity
            android:name="android.app.NativeActivity"
            android:label="Floem 2.0 Demo"
            android:configChanges="orientation|screenSize|keyboardHidden|density"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <meta-data
                android:name="android.app.lib_name"
                android:value="floem2_demo" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
