<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal AndroidManifest.xml for a Rust + Floem app built via `cargo ndk`.

  The key requirements for a `native-activity` based Rust app:
  - `android:hasCode="false"` on <application> (no Kotlin/Java Activity class).
  - A single <activity> whose name matches the native-activity glue
    (`android.app.NativeActivity`) and is enabled + exported.
  - The `android:exported="true"` and the MAIN/LAUNCHER intent filter.

  Place this at `app/src/main/AndroidManifest.xml` in your Android Gradle
  project, then copy the built `*.so` into `app/src/main/jniLibs/<abi>/`.

  OPTIONAL — Android file dialogs + receiving shared files:
  The default activity above works for everything EXCEPT:
    - receiving file-picker results (`floem::platform::open_file` / `save_as`), and
    - receiving files shared into a RUNNING app (ACTION_SEND / ACTION_VIEW via
      `FloemNativeActivity.onNewIntent`).
  (The launch intent — an app started by a share — works even with the default
  `NativeActivity`, because Floem reads `Activity.getIntent()` at startup.)
  To enable these, AND to make the app appear in the share sheet / "open with"
  (see the extra <intent-filter> below):
    1. Add `FloemNativeActivity.java` (in this folder) to your app's Java source
       set as `dev/floem/android/FloemNativeActivity.java`.
    2. Change the <activity> below to
         android:name="dev.floem.android.FloemNativeActivity"
       and remove `android:hasCode="false"` from <application>.
    3. Rebuild with `cargo ndk` and repackage; the `floemOnActivityResult` and
       `floemOnNewIntent` native methods are exported from the Rust `.so`.

  NOTE: scope the <data android:mimeType="..."> in the share intent-filters to
  the file types your app actually handles (e.g. "image/*", "text/*") instead of
  "*/*" to avoid hijacking every share on the device.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.floem"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- OpenGL ES 3.0+ is required by the GPU renderer surface. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="Floem Example"
        android:hasCode="false"
        android:exported="true">

        <activity
            android:name="android.app.NativeActivity"
            android:label="Floem Example"
            android:configChanges="orientation|screenSize|keyboardHidden|density"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <meta-data
                android:name="android.app.lib_name"
                android:value="floem_android_example" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Make the app a share target (ACTION_SEND / SEND_MULTIPLE). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Make the app openable from a file manager / browser (ACTION_VIEW). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
