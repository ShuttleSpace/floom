# The gallery: every component of this satellite, in all three of its design
# systems, side by side, in one binary.
#
# It lives in the root workspace -- `examples/floom-demo` -- not in this one,
# so the manifest path points up out of this directory. The three old targets
# (`material`, `cupertino`, `fluent`) pointed at a `floom-demo` crate that did
# not exist and were broken; there is one gallery now, not one per design
# system, because it shows all three at once.

demo:
    cargo run --manifest-path ../../../Cargo.toml -p floom-demo

# The same gallery without a window: it mounts every page, prints how many
# widgets each painted, and exits. A health check to run by hand.
demo-headless:
    cargo run --manifest-path ../../../Cargo.toml -p floom-demo -- --headless
