<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal AndroidManifest.xml for a Rust + Floom 2.0 app built via `cargo ndk`.

  The key requirements for a `native-activity` based Rust app:
  - `android:hasCode="false"` on <application> (no Kotlin/Java Activity class).
  - A single <activity> whose name matches the native-activity glue
    (`android.app.NativeActivity`) and is enabled + exported.
  - The `android:exported="true"` and the MAIN/LAUNCHER intent filter.

  The `android.app.lib_name` meta-data MUST match the `[lib] name` in
  `Cargo.toml` (`floom2_android_example`), because that is the `*.so`
  `native-activity` loads.

  NOTE: the default `android.app.NativeActivity` + `hasCode="false"`
  configuration covers everything except receiving file-picker results
  and files shared into a *running* app (those need a Java `Activity`
  subclass that forwards `onActivityResult`/`onNewIntent` to Floom's JNI
  bridge). floom2's Android L4 does not yet export those bridges, so this
  example intentionally stays on the default activity.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.floom2"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- OpenGL ES 3.0+ is required by the GPU renderer surface. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="Floom 2.0 Example"
        android:hasCode="false"
        android:exported="true">

        <activity
            android:name="android.app.NativeActivity"
            android:label="Floom 2.0 Example"
            android:configChanges="orientation|screenSize|keyboardHidden|density"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <meta-data
                android:name="android.app.lib_name"
                android:value="floom2_android_example" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
