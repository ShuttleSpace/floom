# Any crate workspace's build output, including nested satellites under crates/.
target/
# `floom run <app.tsx>` generates its throwaway crate here.
.floom/
/.lapce
/.idea
/.zed
/.worktrees
.workbuddy/
.DS_Store
rustc-ice*
*.orig
*.db

# Generated by cargo-xcode / cargo-apple (regenerated, not source)
*.xcodeproj/
*.xcworkspace/
# iOS example local build output and nested lock symlink
examples/ios/build/
examples/ios/Cargo.lock
# The standalone plugin sample and its example regenerate their own lockfiles.
sample/Cargo.lock
sample/example/Cargo.lock

# Python bytecode from the repo tools
__pycache__/
*.pyc

# npm installs for the TypeScript examples and the @types packages
node_modules/

# Test-run and rustdoc output under `tests/`; nothing here is a source file.
/tests/floom-cli-test-*/
/tests/tmp/
/tests/doc/
/tests/dsl-fixture/

# graphify knowledge-graph output — generated on demand, not source.
/graphify-out/

# Agent / editor scratch dirs — local only, never committed.
.superpowers/
.workbuddy/
.jj/
.pi/
.claude/
.agents/
